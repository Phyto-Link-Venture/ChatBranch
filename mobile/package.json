{
  "name": "chatbranch-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The ChatBranch phone app (Capacitor shell around the dashboard) for the App Store and Google Play.",
  "scripts": {
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "cap sync && node scripts/permissions.mjs",
    "icons": "node scripts/icons.mjs",
    "permissions": "node scripts/permissions.mjs",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "node scripts/permissions.mjs && cap run android",
    "run:ios": "node scripts/permissions.mjs && cap run ios",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor-community/contacts": "8.0.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
