# ChatBranch voice agent (profile `voice`) — its speech / AI provider keys.
# Copy to `voice-agent.env` next to docker-compose.yml (chmod 600) and fill in
# what you use; `docker compose up -d` applies changes. The LiveKit keys and
# AGENT_NAME are NOT set here — they live in .env, shared with the API.
#
# The agent refuses to start without the key of its realtime provider and logs
# which one is missing (`docker compose logs agent`).

# Realtime speech model: openai (recommended; needs OPENAI_API_KEY — a real
# OpenAI key, OpenRouter has no Realtime API) or gemini (needs GOOGLE_API_KEY).
REALTIME_PROVIDER=openai
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Cloned / custom voices (the "elevenlabs" voice provider) and the ILMU
# cascade, when a call's voice uses them.
ELEVENLABS_API_KEY=
ILMU_API_KEY=
# The end-of-call summary (any OpenAI-compatible chat model; OpenRouter works).
OPENROUTER_API_KEY=
SUMMARY_MODEL=openai/gpt-4o-mini

# Phone calls: your number in E.164 (+60…), shown to the person called.
CALLER_ID=

# Tuning — the defaults are sensible. Hard cap on a call's length (seconds),
# pause before the first word after the callee answers (ms), end-of-turn
# silence (ms; lower answers sooner but cuts off people who pause), and the
# silence watchdog (re-ask after N seconds, hang up after M).
MAX_CALL_SECONDS=300
ANSWER_SETTLE_MS=1500
VAD_SILENCE_MS=900
SILENCE_NUDGE_SECONDS=12
SILENCE_HANGUP_SECONDS=120
# Background-voice cancellation on inbound audio: telephony | bvc | off.
NOISE_CANCELLATION=telephony
