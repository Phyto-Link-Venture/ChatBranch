# ChatBranch — settings for this server. Copy to `.env` (same folder as
# docker-compose.yml), fill in the four REQUIRED values, keep the file private
# (chmod 600 .env). Docker Compose reads it on every `docker compose …` command;
# after editing, run `docker compose up -d` to apply. A value containing `$`
# must be single-quoted, e.g. SUPERADMIN_PASSWORD='my$ecret'.
#
# Everything else — WhatsApp / email / Telegram accounts, AI provider keys,
# Google sign-in for integrations — is set in the dashboard after the first
# sign-in, not here.


# ============================================================================
# Required
# ============================================================================

# The DNS name of this server, e.g. chat.yourcompany.com — no https://, no
# path. Its A/AAAA record must point at this server and ports 80 + 443 must be
# open: Caddy gets the HTTPS certificate for it automatically on first start.
DOMAIN=

# Password of the `superadmin` login created on the FIRST start. Use a long,
# unique one. Changing it here later does NOT change the account — change the
# password in the dashboard (Settings → My account).
SUPERADMIN_PASSWORD=

# The database password, also used inside the database URL — generate it:
#   openssl rand -hex 32
# Set it before the first start and never change it afterwards (the database
# keeps the password it was created with).
POSTGRES_PASSWORD=

# Shared secret between the API and the WhatsApp Web gateway (profile
# `whatsapp`). Required even if you don't use that profile — generate it:
#   openssl rand -hex 32
BAILEYS_SECRET=


# ============================================================================
# Version and images
# ============================================================================

# Which release to run: a version like 1.4.0, or `latest`. Pin a version in
# production and change it on purpose to upgrade (see README.md → Upgrade).
CHATBRANCH_VERSION=latest

# Where the ChatBranch images come from (each name gets -api, -web, -baileys,
# -agent). Change only if you were told to use another registry.
CHATBRANCH_IMAGE_PREFIX=ghcr.io/phyto-link-venture/chatbranch

# The third-party images, if you need to pin or mirror them.
# CADDY_IMAGE=caddy:2.10-alpine
# POSTGRES_IMAGE=postgres:16-bookworm
# WHISPER_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu


# ============================================================================
# Optional services — comma-join the ones you want, e.g. whatsapp,voice
# ============================================================================
#   whatsapp  WhatsApp numbers paired by QR code (WhatsApp Web — unofficial;
#             read README.md first). The official WhatsApp Business API needs
#             no profile: it is set up in the dashboard.
#   voice     AI phone / WhatsApp calls (needs a LiveKit project, below, and
#             the provider keys in voice-agent.env)
#   stt       local speech-to-text for customers' voice notes (no OpenAI key
#             needed; set STT_PROVIDER=local below)
COMPOSE_PROFILES=


# ============================================================================
# Database backups (the postgres-backup service)
# ============================================================================

# A compressed pg_dump every N hours into the data volume (backups/postgres/).
PG_BACKUP_HOURS=24
# Dumps older than this many days are deleted.
PG_BACKUP_KEEP_DAYS=14


# ============================================================================
# AI calls (profile `voice`) — leave empty if you don't use calls
# ============================================================================

# Your LiveKit project (cloud.livekit.io or self-hosted): its WebSocket URL
# and an API key + secret. The API dials through it; the voice agent joins
# each call through it. Unset = "Call" answers with what is missing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# For phone calls: the LiveKit SIP outbound trunk id (ST_…). Not needed for
# WhatsApp calls.
SIP_OUTBOUND_TRUNK_ID=
# The name the API dispatches the voice agent by. Use a unique one if several
# ChatBranch installs share one LiveKit project.
AGENT_NAME=chatbranch-agent


# ============================================================================
# Voice-note transcription — optional; a choice saved in the dashboard
# (Settings → AI keys & models → Advanced) wins over these
# ============================================================================

# "" = automatic (OpenAI with a key, else ElevenLabs, else none) | openai |
# elevenlabs | local (the `stt` profile's Whisper) | off
STT_PROVIDER=
# Only for STT_PROVIDER=local with your own Whisper server; the `stt` profile's
# is used when empty (http://whisper:8000/v1).
STT_BASE_URL=
# The Whisper model (default Systran/faster-whisper-small — the `stt` profile
# downloads it on first start).
STT_MODEL=
