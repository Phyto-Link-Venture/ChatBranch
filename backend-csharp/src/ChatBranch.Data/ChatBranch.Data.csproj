<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ChatBranch.Domain\ChatBranch.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.1.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
  </ItemGroup>

  <!-- contact import (.xlsx) and invite-link QR codes — both MIT -->
  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- PDF documents for the Documents app skill (invoices, quotations, receipts,
       letters) — PDFsharp + MigraDoc, MIT. The text font (Liberation Sans, SIL OFL
       1.1, Documents/Fonts/LICENSE-OFL.txt) is embedded so a bare container needs
       no system fonts. -->
  <ItemGroup>
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <EmbeddedResource Include="Documents/Fonts/*.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
