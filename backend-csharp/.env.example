# ChatBranch — C# / ASP.NET Core backend (backend-csharp) environment.
#
# EVERYTHING here is OPTIONAL. Like the Django app, this backend boots and runs
# fully in sandbox mode with none of these set. Configuration precedence:
#
#     DB Setting row  >  environment variable  >  appsettings.json default
#
# Provider credentials are meant to be managed from the dashboard (Settings ->
# AI & Providers / App Keys), which writes crm.Setting rows that OVERRIDE the
# env fallbacks below. The env vars exist only as a fallback for headless setups.
# Values are read at process start — restart after editing.
# (.NET also accepts these as real env vars; the ConnectionStrings__ / Cors__
# forms use the standard double-underscore section separator.)


# ============================================================================
# Core
# ============================================================================
# Database connection string (appsettings key ConnectionStrings:Default).
# Default: a local SQLite file created + seeded on first boot. Point it at the
# existing Django DB to share data — the schema already matches.
#   ConnectionStrings__Default=Data Source=../backend/db.sqlite3
ConnectionStrings__Default=

# Directory for file-based data (media, IPC). appsettings key: DataDir.
DataDir=

# CORS: origins allowed to call the API from a browser. Preferred config is the
# Cors:Origins array in appsettings.json (localhost:3000 + the dashboard origin
# are set there). To override via env instead, index each origin:
#   Cors__Origins__0=http://localhost:3000
#   Cors__Origins__1=http://<your-dashboard-origin>


# ============================================================================
# AI chat provider — fallback for the dashboard-managed Setting rows.
# Resolution order: openrouter -> openai -> local. First one configured wins
# (unless the chat_provider Setting pins one — that pin is DB-only, no env).
# ============================================================================
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Local OpenAI-compatible server (Ollama / LM Studio):
LOCAL_BASE_URL=
LOCAL_API_KEY=
# Model id (e.g. openai/gpt-4o-mini for OpenRouter, gpt-4o-mini for OpenAI):
CHAT_MODEL=


# ============================================================================
# Channels / webhooks
# ============================================================================
# WhatsApp Cloud webhook verify token. Preferred: Setting whatsapp_verify_token
# (Settings -> App Keys). Env is the fallback.
WHATSAPP_VERIFY_TOKEN=


# ============================================================================
# Background workers (both ON by default). Set to 0 to disable — e.g. when
# running a second API instance that should not also drain the queue / run flows.
# ============================================================================
QUEUE_WORKER=1
FLOWS_WORKER=1
