# ChatWood — backend environment.
#
# Copy to backend/.env and fill in only what you need. EVERY key below is
# optional for local development: with none of them set, ChatWood runs in
# sandbox mode — the dashboard, inbox, flow builder and knowledge base all work,
# messages are stored locally instead of being sent, and integration actions
# report a clean "not connected, step skipped".
#
# Dashboard-managed settings (channel accounts, AI persona, Twilio SIP creds,
# integration client id/secret, queue pacing) are stored in the database and
# OVERRIDE the matching key here. Blanking one in the dashboard falls back to
# this file. Values here are read at process start — restart after editing.


# ============================================================================
# Django core
# ============================================================================
DEBUG=True
# Generate a real one before deploying:  python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here
# Add your tunnel/production hostname here or Django rejects the request.
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite by default. A postgres:// URL switches the ORM to Postgres.
DATABASE_URL=sqlite:///db.sqlite3
# Where the dashboard runs — used for CORS and for the OAuth bounce-back.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# Needed behind an HTTPS proxy (e.g. a PaaS): comma-separated https:// origins.
CSRF_TRUSTED_ORIGINS=
# Password for the superuser created by `manage.py seed_production`.
SEED_ADMIN_PASSWORD=


# ============================================================================
# AI text brain — chat auto-replies, conversation summaries, memory
# Without one of these, every AI path logs and skips. Nothing else breaks.
# ============================================================================
# OpenRouter is preferred when set; OpenAI is the fallback.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Chat model for auto-replies. Empty = gpt-4o-mini (or openai/gpt-4o-mini via
# OpenRouter). Also editable at Settings -> AI Configuration.
WHATSAPP_CHAT_MODEL=
# Model for the end-of-call summary step (a plain chat completion).
SUMMARY_MODEL=openai/gpt-4o-mini

# AI memory: how often idle chats are summarized, and how long a chat must be
# idle first. Set AICORE_TICKER=0 to disable the background summarizer.
AICORE_SUMMARY_INTERVAL=600
AICORE_SUMMARY_IDLE_MIN=120
AICORE_TICKER=1


# ============================================================================
# Voice calls — LiveKit (required for ANY call: SIP or WhatsApp)
# Get these from https://cloud.livekit.io or your self-hosted server.
# ============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which realtime speech model the agent runs.
#   openai  -> OpenAI Realtime API      (needs OPENAI_API_KEY)  <- recommended
#   gemini  -> Gemini Live native audio (needs GOOGLE_API_KEY)
# NOTE: OpenRouter does NOT support the Realtime API — OPENAI_API_KEY must be a
# real OpenAI key. The agent worker refuses to start if the provider's key is
# missing.
REALTIME_PROVIDER=openai
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
# Input noise reduction — critical on phone/WhatsApp audio.
# far_field (default, most aggressive) | near_field | off
REALTIME_NOISE_REDUCTION=far_field

# Gemini branch (only when REALTIME_PROVIDER=gemini). Key: https://aistudio.google.com/apikey
# Its free tier is flaky (429 / "1011 Deadline") — openai is the tested path.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck
GEMINI_SUMMARY_MODEL=gemini-2.5-flash

# Agent dispatch name — must match on the agent worker and every dial site.
AGENT_NAME=chatwood-agent
# Hard cap on call length in seconds (auto hang-up if the agent's own end_call
# never fires, e.g. a silent caller). 0 disables.
MAX_CALL_SECONDS=300
# Pause (ms) between the callee answering and the agent's first word.
ANSWER_SETTLE_MS=1500
# Voice activity detection. ~900ms; lower values cut off speakers who pause.
VAD_SILENCE_MS=
VAD_THRESHOLD=
# Contact-silence watchdog: after this many seconds of dead air the agent
# re-asks; after SILENCE_HANGUP_SECONDS total it hangs up. Only the contact's
# speech resets the clock.
SILENCE_NUDGE_SECONDS=12
SILENCE_HANGUP_SECONDS=120


# ============================================================================
# Outbound phone calls — SIP trunk (Twilio Elastic SIP Trunking, or similar)
# Optional. Without it, WhatsApp voice calls still work; PSTN dialling does not.
# ============================================================================
# Your voice number in E.164 — also the caller ID shown to the contact.
CALLER_ID=
# Filled in ONCE by running voice_agent/setup_trunk.py.
SIP_OUTBOUND_TRUNK_ID=
# From the Twilio console. Also settable at Settings -> Channels -> Voice, which
# takes precedence per field.
TWILIO_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=


# ============================================================================
# WhatsApp Cloud API (Meta) — text chat + Business Calling
# Leave empty for sandbox mode. Accounts added in the dashboard
# (Settings -> Channels -> WhatsApp) take precedence; these keys surface as a
# single read-only "From backend/.env" account.
# ============================================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Meta app secret. REQUIRED once any account is configured — the webhook rejects
# every unsigned POST from that point on.
WHATSAPP_APP_SECRET=
# WhatsApp Business Account ID — needed to LIST approved templates. Sending a
# template by name works without it.
WHATSAPP_WABA_ID=
# Webhook verify token. The value below is PUBLIC (it ships in this repo) and is
# never accepted: leave it and the app generates a random one on first use.
# Always copy the live value from Settings -> App Keys.
WHATSAPP_VERIFY_TOKEN=chatwood-verify
# Outreach quiet hours, "HH:MM" 24h, SERVER-LOCAL time (no per-contact
# timezones). AI replies are skipped and template sends blocked during them;
# manual operator sends stay allowed. Empty = disabled.
# Also editable at Settings -> AI Configuration.
WHATSAPP_QUIET_START=
WHATSAPP_QUIET_END=
# Periodic account-health checker. Seconds between passes; 0 or
# WHATSAPP_HEALTH_CHECKS=0 disables it.
WHATSAPP_HEALTH_INTERVAL=300
WHATSAPP_HEALTH_CHECKS=1
# Record WhatsApp Cloud bridge calls to backend/data/whatsapp/calls/recordings/.
WHATSAPP_RECORD_CALLS=1
# ICE/TURN servers for the Cloud call bridge's WebRTC leg (aiortc). JSON list of
# {"urls": ..., "username"?, "credential"?}. Empty = aiortc defaults; add a TURN
# entry if calls connect but carry no audio behind strict NAT. Malformed JSON is
# ignored with a warning. Example:
# WHATSAPP_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
WHATSAPP_ICE_SERVERS=


# ============================================================================
# Baileys gateway — unofficial WhatsApp Web transport (optional)
# ⚠ Violates WhatsApp's Terms of Service. Dev/demo only, ban risk is real, use a
#   dedicated spare number. See backend/baileys_service/README.md + RESEARCH.md.
# ============================================================================
BAILEYS_PORT=3020
# Shared secret between Django and the gateway. CHANGE THIS anywhere real.
BAILEYS_SECRET=baileys-local-dev
# Where Django reaches the gateway (and, on the Node side, where the gateway
# pushes back).
BAILEYS_URL=http://127.0.0.1:3020
# Node-side only (read by baileys_service): record calls to local WAV files.
BAILEYS_RECORD_CALLS=1
BAILEYS_LOG_LEVEL=info
# Inbound-audio noise gate on calls: frames quieter than this dBFS are muted
# before the agent hears them (recordings keep the raw audio). More negative =
# lets more quiet sound through; 0 disables.
BAILEYS_GATE_DB=-30
BAILEYS_GATE_HOLD_MS=400


# ============================================================================
# Email channel (SMTP out / IMAP in)
# Per-mailbox credentials set in Settings -> Channels -> Email override these;
# these are the single-mailbox fallback.
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
EMAIL_DEFAULT_SUBJECT=Following up
# Inbound. Leave IMAP_HOST empty for outbound-only email (no inbound sync).
IMAP_HOST=
IMAP_PORT=993


# ============================================================================
# Integrations (Settings -> Integrations overrides these per field)
# ============================================================================
# One Google Cloud OAuth 2.0 client, shared by Calendar / Drive / Gmail / Sheets.
# Authorized redirect URI must be:
#   <your api origin>/api/integrations/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the derived redirect URI is wrong (e.g. behind a proxy).
GOOGLE_REDIRECT_URI=
# Webhook signing secrets. With NO secret configured the matching webhook
# returns 503 — it never accepts an unsigned payload.
SHOPIFY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=


# ============================================================================
# Optional extras
# ============================================================================
# ElevenLabs — voice cloning + cloned-voice call pipelines. Unset = disabled.
ELEVENLABS_API_KEY=
# LLM behind the ElevenLabs voice pipeline: "openai" (default) or "ilmu".
PIPELINE_LLM_PROVIDER=
# YTL ILMU (api.ilmu.ai, OpenAI-compatible) — optional alternative chat/voice
# provider. Key from console.ilmu.ai.
ILMU_API_KEY=
# Voice-agent STT sensitivity (ElevenLabs pipeline calls): Silero speech
# confidence 0..1 (higher = stricter) and minimum speech seconds per turn.
SILERO_ACTIVATION=0.6
SILERO_MIN_SPEECH_S=0.2

# Flow engine ticker: FLOWS_TICKER=0 disables the in-process scheduler (use
# `manage.py flows_tick` instead). Interval in seconds.
FLOWS_TICKER=1
FLOWS_TICK_SECONDS=30

# Cloudflare R2 sync of backend/data/ (staging/production only). When set,
# core/r2sync.py restores data/ from the bucket at boot and backs changes up
# every R2_SYNC_INTERVAL seconds. Leave unset for local dev.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=
# R2_REGION=auto
# R2_SYNC_INTERVAL=300
# R2_SYNC_DISABLE=0
