# ChatBranch — backend environment.
#
# Copy to backend/.env. EVERY key here is optional for local development: with
# none of them set, ChatBranch runs in sandbox mode — the dashboard, inbox,
# flow builder and knowledge base all work, messages are stored locally instead
# of being sent, and integration actions report a clean "not connected, step
# skipped".
#
# MOST provider credentials are NOT set here anymore — they are managed from
# the dashboard and stored in the database (crm.Setting / ChannelAccount /
# Integration rows), which OVERRIDE any matching env key. Add them in:
#   Settings -> AI & Providers      OPENROUTER_API_KEY / OPENAI_API_KEY /
#                                   GOOGLE_API_KEY / chat model
#   Settings -> Channels            WhatsApp Cloud accounts (token, phone id,
#                                   app secret, WABA id), Telegram, Messenger/
#                                   Instagram, Email (SMTP/IMAP), Voice (Twilio)
#   Settings -> App Keys            webhook verify token
#   Settings -> Integrations        Google OAuth client, Shopify/Stripe webhook
#                                   secrets
# The matching env keys (WHATSAPP_*, SMTP_*/IMAP_*, GOOGLE_CLIENT_*,
# SHOPIFY_WEBHOOK_SECRET, STRIPE_WEBHOOK_SECRET, ...) still work as fallbacks
# if you prefer env-based config — see git history of this file for the full
# annotated list.
#
# What REMAINS here is what a Django-free process reads at boot (the LiveKit
# voice agent in voice_agent/, the Baileys Node gateway in baileys_service/)
# plus Django's own core settings. Values are read at process start — restart
# after editing.


# ============================================================================
# Django core
# ============================================================================
DEBUG=True
# Generate a real one before deploying:  python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here
# Add your tunnel/production hostname here or Django rejects the request.
ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite by default. A postgres:// URL switches the ORM to Postgres.
DATABASE_URL=sqlite:///db.sqlite3
# Where the dashboard runs — used for CORS and for the OAuth bounce-back.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# Needed behind an HTTPS proxy (e.g. a PaaS): comma-separated https:// origins.
CSRF_TRUSTED_ORIGINS=
# Password for the superuser created by `manage.py seed_production`.
SEED_ADMIN_PASSWORD=


# ============================================================================
# Voice calls — read AT BOOT by the Django-free agent worker (voice_agent/).
# Optional: without LIVEKIT_* the agent worker will not start (everything else
# still runs). Required for ANY call, SIP or WhatsApp.
# ============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Realtime speech model: openai (recommended; needs OPENAI_API_KEY below) or
# gemini (needs GOOGLE_API_KEY; free tier is flaky). The worker refuses to
# start if the chosen provider's key is missing.
REALTIME_PROVIDER=openai
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
# The agent reads these from env at boot even though chat-side AI reads them
# from the dashboard: a real OpenAI key (OpenRouter does NOT support the
# Realtime API), and ElevenLabs for cloned-voice pipelines.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
# End-of-call summary model (plain chat completion; OpenRouter ok).
SUMMARY_MODEL=openai/gpt-4o-mini
# Agent dispatch name — must match on the agent worker and every dial site.
# Use a UNIQUE name per app if several apps share one LiveKit project.
AGENT_NAME=chatbranch-agent
# Tuning (defaults are sensible): hard cap on call seconds, pause before the
# first word, VAD, and the contact-silence watchdog.
MAX_CALL_SECONDS=300
ANSWER_SETTLE_MS=1500
VAD_SILENCE_MS=
VAD_THRESHOLD=
SILENCE_NUDGE_SECONDS=12
SILENCE_HANGUP_SECONDS=120

# --- SIP trunk (PSTN dialling; optional — WhatsApp calls work without it) ---
# Your voice number in E.164 — also the caller ID shown to the contact.
CALLER_ID=
# Filled in ONCE by running voice_agent/setup_trunk.py.
SIP_OUTBOUND_TRUNK_ID=
# From the Twilio console (only needed to run setup_trunk.py; the REST voice
# keys are dashboard-managed at Settings -> Channels -> Voice).
TWILIO_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# --- Browser call test page (voice_agent/token_server.py; optional) ---
TOKEN_SERVER_PORT=8080
TOKEN_SERVER_HOST=127.0.0.1
ENABLE_TEST_PAGE=1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080


# ============================================================================
# Baileys gateway — read AT BOOT by the Node sidecar (baileys_service/).
# ⚠ Unofficial WhatsApp Web transport: ToS-violating, dev/demo only.
# ============================================================================
BAILEYS_PORT=3020
# Shared secret between Django and the gateway. CHANGE THIS anywhere real.
BAILEYS_SECRET=baileys-local-dev
# Where Django reaches the gateway / where the gateway pushes back to Django.
# If you run TWO apps side by side, give each its own port trio (web/api/
# gateway) and point these at the right one.
BAILEYS_URL=http://127.0.0.1:3020
DJANGO_URL=http://127.0.0.1:8000
BAILEYS_RECORD_CALLS=1
BAILEYS_LOG_LEVEL=info
# Inbound-audio noise gate on calls (dBFS; 0 disables).
BAILEYS_GATE_DB=-30
BAILEYS_GATE_HOLD_MS=400


# ============================================================================
# Background threads (in-process tickers) — read once at boot. 0 disables.
# ============================================================================
AICORE_TICKER=1
FLOWS_TICKER=1
WHATSAPP_HEALTH_CHECKS=1
# Record WhatsApp Cloud bridge calls under backend/data/whatsapp/calls/.
WHATSAPP_RECORD_CALLS=1
# ICE/TURN for the Cloud call bridge (JSON list). Empty = aiortc defaults.
WHATSAPP_ICE_SERVERS=


# ============================================================================
# Cloudflare R2 sync of backend/data/ (staging/production only). Leave unset
# for local dev — core/r2sync.py restores at boot + backs up on an interval.
# ============================================================================
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=
# R2_REGION=auto
# R2_SYNC_INTERVAL=300
# R2_SYNC_DISABLE=0
