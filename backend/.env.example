# ChatBranch — backend environment.
#
# Copy to backend/.env. EVERY key here is optional for local development: with
# none of them set, ChatBranch runs in sandbox mode — the dashboard, inbox,
# flow builder and knowledge base all work, messages are stored locally instead
# of being sent, and integration actions report a clean "not connected, step
# skipped".
#
# MOST provider credentials are NOT set here anymore — they are managed from
# the dashboard and stored in the database (Setting / ChannelAccount /
# Integration rows), which OVERRIDE any matching env key. Add them in:
#   Settings -> AI & Providers      OPENROUTER_API_KEY / OPENAI_API_KEY /
#                                   GOOGLE_API_KEY / chat model
#   Settings -> Channels            WhatsApp Cloud accounts (token, phone id,
#                                   app secret, WABA id), Telegram, Messenger/
#                                   Instagram, Email (SMTP/IMAP), Voice (Twilio)
#   Settings -> App Keys            webhook verify token
#   Settings -> Integrations        Google OAuth client, Shopify/Stripe webhook
#                                   secrets
# The matching env keys (WHATSAPP_*, SMTP_*/IMAP_*, GOOGLE_CLIENT_*,
# SHOPIFY_WEBHOOK_SECRET, STRIPE_WEBHOOK_SECRET, ...) still work as fallbacks
# if you prefer env-based config — see git history of this file for the full
# annotated list.
#
# Who reads this file: the voice agent worker (voice_agent/) and the Baileys
# gateway (baileys_service/) load it themselves at boot; the C# API reads the
# LiveKit / SIP keys from it to place calls, and everything else from its
# process environment (docker compose passes this file to every service).
# Values are read at process start — restart after editing.


# ============================================================================
# API (C#)
# ============================================================================
# Where the dashboard runs — the OAuth callback bounces the operator back here.
FRONTEND_URL=http://localhost:3000
# Password for the seeded superadmin login (the POC default when unset).
SUPERADMIN_PASSWORD=
# The ONE data directory shared by the API and the voice agent (live call
# transcripts, the operator inbox, calls.json, recordings, media). Default:
# backend/data in a checkout; Docker uses /data. Set the same absolute path for
# both processes if either runs elsewhere.
CHATBRANCH_DATA_DIR=


# ============================================================================
# Voice calls — the LiveKit voice agent worker (voice_agent/, Node) reads these
# at boot; the API reads LIVEKIT_* + SIP_OUTBOUND_TRUNK_ID + AGENT_NAME to place
# calls. Optional: without LIVEKIT_* the worker exits at once with the missing
# names (everything else still runs). Required for ANY call, SIP or WhatsApp.
# ============================================================================
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Realtime speech model: openai (recommended; needs OPENAI_API_KEY below) or
# gemini (needs GOOGLE_API_KEY; free tier is flaky). The worker refuses to
# start if the chosen provider's key is missing.
REALTIME_PROVIDER=openai
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
# The agent reads these from env at boot even though chat-side AI reads them
# from the dashboard: a real OpenAI key (OpenRouter does NOT support the
# Realtime API), ElevenLabs for cloned-voice cascades, ILMU for the
# Malaysian-hosted cascade (voice_1/2/3).
OPENAI_API_KEY=
GOOGLE_API_KEY=
ELEVENLABS_API_KEY=
ILMU_API_KEY=
# End-of-call summary model (plain chat completion; OpenRouter ok).
SUMMARY_MODEL=openai/gpt-4o-mini
# Agent dispatch name — must match on the agent worker and every dial site.
# Use a UNIQUE name per app if several apps share one LiveKit project.
AGENT_NAME=chatbranch-agent
# Tuning (defaults are sensible): hard cap on call seconds, pause before the
# first word, the end-of-turn silence (ms; lower replies sooner but cuts off
# callers who pause), and the contact-silence watchdog.
MAX_CALL_SECONDS=300
ANSWER_SETTLE_MS=1500
VAD_SILENCE_MS=900
VAD_THRESHOLD=
SILENCE_NUDGE_SECONDS=12
SILENCE_HANGUP_SECONDS=120
# Krisp background-voice cancellation on inbound audio: telephony | bvc | off.
NOISE_CANCELLATION=telephony

# --- SIP trunk (PSTN dialling; optional — WhatsApp calls work without it) ---
# Your voice number in E.164 — also the caller ID shown to the contact.
CALLER_ID=
# Filled in ONCE by `npm --prefix backend/voice_agent run setup-trunk`.
SIP_OUTBOUND_TRUNK_ID=
# From the Twilio console (only needed to create the trunk; the REST voice
# keys are dashboard-managed at Settings -> Channels -> Voice).
TWILIO_TERMINATION_URI=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# --- Inbound speech gate (cascade calls; realtime uses the model's own NR) ---
# vad (default) = WebRTC VAD speech classifier — only real speech reaches STT,
# loud non-speech (TV/traffic/line noise) is muted, quiet speech passes.
# db = energy gate (frames under VOICE_GATE_DB dBFS muted; 0 = meter only).
# off = no gating. VAD_AGGRESSIVENESS 0-3 (higher mutes more noise but can
# clip soft speakers). VOICE_GATE_DEBUG=0 silences the per-second meter.
VOICE_GATE_MODE=vad
VAD_AGGRESSIVENESS=2
VOICE_GATE_DB=0
VOICE_GATE_HOLD_MS=700
VOICE_GATE_DEBUG=1


# ============================================================================
# Baileys gateway — read AT BOOT by the Node sidecar (baileys_service/).
# ⚠ Unofficial WhatsApp Web transport: ToS-violating, dev/demo only.
# ============================================================================
BAILEYS_PORT=3020
# Shared secret between the API and the gateway. CHANGE THIS anywhere real.
BAILEYS_SECRET=baileys-local-dev
# Where the API reaches the gateway / where the gateway pushes back to the API.
# If you run TWO apps side by side, give each its own port trio (web/api/
# gateway) and point these at the right one. (DJANGO_URL is still accepted
# as the old name of API_URL.)
BAILEYS_URL=http://127.0.0.1:3020
API_URL=http://127.0.0.1:8090
BAILEYS_RECORD_CALLS=1
BAILEYS_LOG_LEVEL=info
# Inbound-audio noise gate on calls (dBFS; 0 disables). It applies to every
# WhatsApp call; the voice agent's VOICE_GATE_MODE gate covers cascade calls on
# every transport — set this to 0 if cascade audio sounds gated twice.
BAILEYS_GATE_DB=-30
BAILEYS_GATE_HOLD_MS=400


# ============================================================================
# API background workers — read once at boot. 0 disables.
# ============================================================================
QUEUE_WORKER=1
FLOWS_WORKER=1
