# ChatBranch dashboard — frontend environment.
# Copy to frontend/.env.local and adjust. All keys are OPTIONAL for local dev
# (the defaults below are what the code falls back to).

# Base URL of the backend API (note the trailing /api).
#   Django backend:      http://localhost:8000/api
#   C# / ASP.NET backend: http://localhost:8090/api   (backend-csharp)
# For a remote/hosted backend, use its public origin, e.g.
#   http://<server-ip>:8090/api
# Whatever origin the dashboard is served from must be in the backend's CORS
# allow-list (Django CORS_ALLOWED_ORIGINS, or backend-csharp Cors:Origins).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Max concurrent outbound voice calls the UI will start at once. Set to your
# SIP trunk's channel limit. Default 3.
NEXT_PUBLIC_MAX_CONCURRENT=3
