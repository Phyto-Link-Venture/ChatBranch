# ChatBranch dashboard — frontend environment.
# Copy to frontend/.env.local and adjust. All keys are OPTIONAL for local dev
# (the defaults below are what the code falls back to).

# Base URL of the C# API (note the trailing /api). Baked in at BUILD time.
# For a remote/hosted backend, use its public origin, e.g.
#   http://<server-ip>:8090/api
# Whatever origin the dashboard is served from must be in the API's CORS
# allow-list (Cors:Origins, e.g. Cors__Origins__0 in docker-compose.yml).
# Or RELATIVE — /api — when one proxy serves both on the same origin (/api/* →
# the API, the rest → the dashboard): the build then works on any domain. The
# release images are built that way (see src/lib/apiBase.ts).
NEXT_PUBLIC_API_URL=http://localhost:8090/api

# Max concurrent outbound voice calls the UI will start at once. Set to your
# SIP trunk's channel limit. Default 3.
NEXT_PUBLIC_MAX_CONCURRENT=3
