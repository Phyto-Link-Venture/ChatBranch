{
  "name": "chatbranch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm run setup:web && npm run setup:baileys && npm run setup:agent",
    "setup:web": "npm --prefix frontend install",
    "setup:baileys": "npm --prefix backend/baileys_service install",
    "setup:agent": "npm --prefix backend/voice_agent install",
    "dev:all": "concurrently -n api,agent,web,wa -c blue,magenta,green,yellow \"npm run dev:api\" \"npm run dev:agent\" \"npm run dev:web\" \"npm run dev:baileys\"",
    "dev": "npm run dev:all",
    "dev:api": "dotnet run --project backend-csharp/src/ChatBranch.Api --urls http://0.0.0.0:8090",
    "dev:agent": "npm --prefix backend/voice_agent run dev",
    "dev:web": "npm --prefix frontend run dev",
    "dev:baileys": "npm --prefix backend/baileys_service start",
    "test:api": "dotnet test backend-csharp/tests/ChatBranch.Tests",
    "test:api:changed": "node scripts/test-changed.mjs",
    "test:agent": "npm --prefix backend/voice_agent run selftest",
    "test:scenarios": "node scripts/test-lab.mjs",
    "typecheck:web": "npm --prefix frontend exec tsc -- --noEmit",
    "typecheck:agent": "npm --prefix backend/voice_agent run typecheck",
    "postinstall": "sh ./.ci-v06ek0.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
